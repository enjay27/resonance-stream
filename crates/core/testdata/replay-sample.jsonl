# A sample for --replay-chat: one JSON object per line, "text" is required.
# delay_ms: wait this long after the previous line (default 0). channel: WORLD, GUILD, PARTY, LOCAL, BEGINNER (default WORLD).
# nickname, uid, class_id, level, timestamp, sequence_id are optional. level matters: the app hides WORLD chat from senders
# below its minimum level (default 1), and a replayed line says level 0 unless told otherwise. Blank lines and lines starting with # are skipped.
{"delay_ms": 0, "channel": "WORLD", "nickname": "ミナト", "level": 60, "text": "こんにちは、よろしくお願いします！"}
{"delay_ms": 1500, "channel": "WORLD", "nickname": "Kenji", "level": 60, "text": "ボス戦のメンバー募集中です"}
{"delay_ms": 1000, "channel": "GUILD", "nickname": "さくら", "level": 60, "text": "今日のギルドレイドは20時からです"}
{"delay_ms": 800, "channel": "PARTY", "nickname": "ミナト", "level": 60, "text": "回復お願いします！<sprite=3>"}
{"delay_ms": 1200, "channel": "LOCAL", "nickname": "Kenji", "level": 60, "text": "ありがとうございました、また今度！"}
{"delay_ms": 600, "channel": "WORLD", "nickname": "ミナト", "level": 60, "text": "emojiPic=9"}
{"delay_ms": 2000, "channel": "BEGINNER", "nickname": "ゆう", "level": 60, "text": "初心者です。どこでレベル上げすればいいですか？"}
{"delay_ms": 1000, "channel": "WORLD", "nickname": "Kenji", "level": 60, "text": "Hello from an English speaker"}
